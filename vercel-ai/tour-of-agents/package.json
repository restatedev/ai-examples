{
  "name": "restate-vercel-agents",
  "version": "0.0.1",
  "description": "Tour of Agents with Restate and AI SDK",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmitOnError",
    "prebundle": "rm -rf dist",
    "bundle": "esbuild src/app.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=dist/app.js",
    "postbundle": "cd dist && zip -r index.zip app.js*"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.1",
    "@ai-sdk/openai": "^4.0.17",
    "@restatedev/restate-sdk": "^1.16.2",
    "@restatedev/restate-sdk-zod": "^1.16.2",
    "@restatedev/vercel-ai-middleware": "^0.4.0",
    "ai": "^7.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.4",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
